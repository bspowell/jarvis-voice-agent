# Jarvis secrets. Copy to `.env` and fill in as each phase needs them.
# `.env` is gitignored; never commit real keys. Check status with: uv run jarvis doctor

# --- Phase 1: the brain ---
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jarvis

# --- Phase 4: search agent ---
FIRECRAWL_API_KEY=

# --- Phase 7: voice ---
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
# Local LiveKit server (`livekit-server --dev` uses these fixed dev credentials)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Google and Notion need no keys here: Jarvis shows a sign-in button on first use.
