# Jarvis secrets. Copy to `.env` and fill in the keys you need (the README says which).
# `.env` is gitignored; never commit real keys. Check status with: uv run jarvis doctor

# --- The brain ---
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jarvis

# --- Web search agent ---
FIRECRAWL_API_KEY=

# --- Calendar agent (Google Calendar and to-dos) ---
# Jarvis's Google sign-in app: Google Cloud → Google Auth Platform → Clients → Desktop app.
# Your account's tokens never go here: Jarvis keeps them in the macOS Keychain after you sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Voice ---
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_VOICE_ID=
# Local LiveKit server (`livekit-server --dev` uses these fixed dev credentials)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Signing in (Google, Notion) happens on first use: Jarvis shows a sign-in button.
# Notion needs nothing here: Jarvis registers himself with Notion when you first connect.

# --- Optional: home city for the weather when the IP lookup fails (overrides jarvis.toml) ---
# LOCATION__HOME_CITY=Vancouver, BC
